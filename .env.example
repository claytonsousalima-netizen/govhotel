# ============================================================
# .env.example — Gov Estancorp
#
# Copy this file to .env and fill in your values.
# This file is NOT committed to git (see .gitignore).
# ============================================================

# Docker Compose / Docker Swarm Configuration
# These variables are used by docker-compose.yml when deploying

# Stack name for Docker Swarm
STACK_NAME=govhotel

# Container registry organization (your GitHub username)
REGISTRY_ORG=claytonsousalima-netizen

# Docker image tag (set by CI/CD, or use 'latest' for manual deploys)
IMAGE_TAG=latest

# ============================================================
# Supabase Configuration
#
# These are loaded by config.js on the VM.
# Keep this file secure — it contains your Supabase credentials.
# ============================================================

# Get these from your Supabase project:
# Dashboard → Project Settings → API

# Project URL (https://xxx.supabase.co)
SUPABASE_URL=https://xxx.supabase.co

# Anon public key (safe for frontend, protected by RLS)
SUPABASE_KEY=eyJhbxxxxxxxxxxxxxxxxxxxxxxIkpXVCJ9.xxx.xxx

# ============================================================
# AWS Configuration (for EC2 bootstrap)
# ============================================================

AWS_REGION=us-east-1
AWS_PROFILE=estancorp
